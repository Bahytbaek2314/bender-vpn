<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <com.example.bendervpn.GlowBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/homePage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отключено"
                    android:textColor="#AAAAAA"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/proBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Pro активен"
                    android:textColor="#B388FF"
                    android:textSize="13sp"
                    android:visibility="gone"/>

                <com.example.bendervpn.PowerButton
                    android:id="@+id/vpnButton"
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:scaleType="fitCenter"/>

                <LinearLayout
                    android:id="@+id/serverRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="28dp"
                    android:padding="16dp"
                    android:background="#1A1A1A">

                    <com.example.bendervpn.FlagView
                        android:id="@+id/homeFlag"
                        android:layout_width="34dp"
                        android:layout_height="22dp"
                        android:layout_marginRight="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/serverText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Германия"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/cityText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Франкфурт"
                            android:textColor="#8E8E8E"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/pingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="23 ms"
                        android:textColor="#3DDC84"
                        android:textSize="14sp"/>
                    <com.example.bendervpn.SignalBars
                        android:id="@+id/signalBars"
                        android:layout_width="34dp"
                        android:layout_height="18dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="›"
                        android:textColor="#888888"
                        android:textSize="18sp"/>
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/proPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pro"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/proState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Оплати в боте и вставь ключ сюда."
                        android:textColor="#AAAAAA"
                        android:textSize="15sp"/>
                    <LinearLayout
                        android:id="@+id/proCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1   Оплати подписку в Telegram-боте"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="2   Скопируй ключ из бота"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="3   Вставь ключ ниже"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/proKeyInput"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="14dp"
                        android:background="#161616"
                        android:gravity="top"
                        android:hint="Вставь ключ из бота"
                        android:inputType="textMultiLine"
                        android:padding="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#777777"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/saveProKey"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="Активировать Pro"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/clearProKey"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Удалить ключ"
                        android:textColor="#8E8E8E"
                        android:textSize="14sp"
                        android:visibility="gone"/>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/locationsPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Локации"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:id="@+id/locationsBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="12dp"/>
                </ScrollView>
            </LinearLayout>

            <ScrollView
                android:id="@+id/settingsPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Настройки"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>
                    <LinearLayout android:id="@+id/rowStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:layout_marginBottom="10dp">
                        <com.example.bendervpn.LineIcon android:layout_width="22dp" android:layout_height="22dp" android:tag="status"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="14dp" android:text="Статус" android:textColor="#FFFFFF" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#666666" android:textSize="22sp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/rowImport" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:layout_marginBottom="10dp">
                        <com.example.bendervpn.LineIcon android:layout_width="22dp" android:layout_height="22dp" android:tag="key"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="14dp" android:text="Импорт ключа" android:textColor="#FFFFFF" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#666666" android:textSize="22sp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/rowSupport" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:layout_marginBottom="10dp">
                        <com.example.bendervpn.LineIcon android:layout_width="22dp" android:layout_height="22dp" android:tag="chat"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="14dp" android:text="Поддержка" android:textColor="#FFFFFF" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#666666" android:textSize="22sp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/rowTelegram" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
                        <com.example.bendervpn.LineIcon android:layout_width="22dp" android:layout_height="22dp" android:tag="plane"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="14dp" android:text="Наш Telegram" android:textColor="#FFFFFF" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#666666" android:textSize="22sp"/>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <LinearLayout android:id="@+id/tabHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <FrameLayout android:id="@+id/bubbleHome" android:layout_width="34dp" android:layout_height="34dp">
                    <com.example.bendervpn.LineIcon android:id="@+id/iconHome" android:layout_width="match_parent" android:layout_height="match_parent" android:tag="home"/>
                </FrameLayout>
                <TextView android:id="@+id/labelHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Главная" android:textColor="#8E8E8E" android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/tabPro" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <FrameLayout android:id="@+id/bubblePro" android:layout_width="34dp" android:layout_height="34dp">
                    <com.example.bendervpn.LineIcon android:id="@+id/iconPro" android:layout_width="match_parent" android:layout_height="match_parent" android:tag="crown"/>
                </FrameLayout>
                <TextView android:id="@+id/labelPro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pro" android:textColor="#8E8E8E" android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/tabLocations" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <FrameLayout android:id="@+id/bubbleLocations" android:layout_width="34dp" android:layout_height="34dp">
                    <com.example.bendervpn.LineIcon android:id="@+id/iconLocations" android:layout_width="match_parent" android:layout_height="match_parent" android:tag="globe"/>
                </FrameLayout>
                <TextView android:id="@+id/labelLocations" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Локации" android:textColor="#8E8E8E" android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/tabSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <FrameLayout android:id="@+id/bubbleSettings" android:layout_width="34dp" android:layout_height="34dp">
                    <com.example.bendervpn.LineIcon android:id="@+id/iconSettings" android:layout_width="match_parent" android:layout_height="match_parent" android:tag="gear"/>
                </FrameLayout>
                <TextView android:id="@+id/labelSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Настройки" android:textColor="#8E8E8E" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
